+
+def source_timestamp_snapshot(conn: sqlite3.Connection) -> dict[str, Any]:
+    cur = conn.cursor()
+    out: dict[str, Any] = {}
+    for table in OFFICIAL_SOURCE_TABLES:
+        if not table_exists(cur, table):
+            out[table] = None
+            continue
+        cols = columns(cur, table)
+        parts = {}
+        for col in ("date", "created_at", "updated_at", "verified_at"):
+            if col in cols:
+                parts[col] = cur.execute(f"SELECT MAX({col}) FROM {table}").fetchone()[0]
+        out[table] = parts
+    return out
+
+
+def source_hash_ref(snapshot: dict[str, Any]) -> str:
+    return hashlib.sha256(json.dumps(snapshot, sort_keys=True, default=str).encode("utf-8")).hexdigest()
+
+
+def official_tables_changed(before: dict[str, Any], after: dict[str, Any]) -> bool:
+    return any(before.get(t, {}).get("sha256") != after.get(t, {}).get("sha256") for t in OFFICIAL_SOURCE_TABLES)
