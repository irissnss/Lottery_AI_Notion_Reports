+            _now(),
+        ),
+    )
+
+
+def _actual_tails_for_preview(cur: sqlite3.Cursor, date: str, region: str) -> set[str]:
+    rows = cur.execute(
+        "SELECT prizes_json FROM lottery_results WHERE date=? AND region=?",
+        (date, region),
+    ).fetchall()
