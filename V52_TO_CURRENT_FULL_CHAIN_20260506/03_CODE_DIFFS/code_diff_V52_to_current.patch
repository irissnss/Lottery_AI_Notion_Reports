+  <body>
+    <div class="dudoan-page">
+      <header class="dudoan-header">
+        <div class="dudoan-header-left">
+          <span class="danger-badge">Test Lane</span>
+          <h1>Dự Đoán Test <span id="regionTitle">MB</span> <span class="test-version" id="testVersion">v52.6</span></h1>
+        </div>
+        <div class="dudoan-header-right">
+          <a href="/du-doan">⬅ Dự đoán chính</a>
+          <a href="/app" id="adminLink" style="display:none">⚙️ Dashboard</a>
+          <button type="button" onclick="loadPreview()">🔄 Refresh</button>
+        </div>
+      </header>
+
+      <div class="dudoan-tabs">
+        <button class="dudoan-tab" id="tabMN" type="button" onclick="setRegion('MN')">MN test/readiness</button>
+        <button class="dudoan-tab" id="tabMT" type="button" onclick="setRegion('MT')">MT test/readiness</button>
+        <button class="dudoan-tab active" id="tabMB" type="button" onclick="setRegion('MB')">MB test</button>
+      </div>
+
+      <main class="dudoan-main">
+        <div id="app" class="loading">⏳ Đang tải dự đoán test...</div>
+
+        <div class="footer-note">
+          Safety contract: page này chỉ đọc <code>mb_experimental_preview_shadow</code> + <code>experimental_preview_shadow</code> + <code>du_doan_test_*</code>.
+          Đọc <code>final_bundles</code> chỉ để hiển thị baseline official ở cột bên trái — không ghi, không can thiệp.
+          Không thay đổi scoring/bundle voting/prompt/model roster. Trang dành cho admin/dev, không ảnh hưởng <code>/du-doan</code>.
+        </div>
+      </main>
+    </div>
+
+    <script>
+      var API_BASE = '';
+      var selectedRegion = 'MB';
+      var selectedWindow = '30';
+
+      fetch('/api/auth/check', { credentials: 'include' })
+        .then(function(r) { return r.json(); })
+        .then(function(d) {
+          if (!d.authenticated) { window.location.href = '/login'; return; }
+          if (d.role !== 'admin') {
+            document.getElementById('app').innerHTML =
+              '<div class="v11-card"><div class="v11-card-title">Không có quyền truy cập</div>' +
+              '<div class="v11-card-sub">Trang này chỉ dành cho admin/dev.</div></div>';
+            return;
+          }
+          document.getElementById('adminLink').style.display = '';
+          loadPreview();
+        })
+        .catch(function() { window.location.href = '/login'; });
+
+      function safeList(v) { return Array.isArray(v) ? v : []; }
+      function setRegion(region) {
+        selectedRegion = region;
+        ['MN','MT','MB'].forEach(function(r) {
+          var el = document.getElementById('tab' + r);
+          if (el) el.className = 'dudoan-tab' + (r === selectedRegion ? ' active' : '');
+        });
+        var title = document.getElementById('regionTitle');
+        if (title) title.textContent = region;
+        loadPreview();
+      }
+      function setWindowDays(days) {
+        selectedWindow = String(days);
+        loadPreview();
+      }
+      function formatDateVN(s) {
+        if (!s) return '';
+        var p = String(s).split('-');
+        return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : s;
+      }
+      function statusLabel(s) { return s ? String(s) : 'PENDING'; }
+      function getVerifyBadge(status) {
+        if (!status) return '';
+        var map = {
+          'WIN': { cls: 'verify-win', icon: '✅', label: 'Trúng' },
+          'LOSE': { cls: 'verify-lose', icon: '❌', label: 'Trượt' },
+          'PARTIAL': { cls: 'verify-partial', icon: '⚡', label: 'Phụ' },
+          'PENDING': { cls: 'verify-pending', icon: '⏳', label: 'Chờ' }
+        };
+        var s = map[status];
+        if (!s) return '';
+        return '<span class="verify-badge ' + s.cls + '">' + s.icon + ' ' + s.label + '</span>';
+      }
