+                region_penalty_score, latency_score, final_budget_score,
+                pick_for_date_json, reason, skip_reason, created_at
+            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
+            """,
+            (
+                budget_id, date, region, row["model_name"], row["model_class"], row["model_role"],
+                row["provider"], row["registry_status"], row["output_eligible"],
+                row["selector_role"], 1 if row["model_name"] in controls else 0,
