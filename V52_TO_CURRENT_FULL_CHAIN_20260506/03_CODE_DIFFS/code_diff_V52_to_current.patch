+    conn = sqlite3.connect(DB_PATH)
+    conn.row_factory = sqlite3.Row
+    return conn
+
+
+def _loads(raw: Any, default: Any) -> Any:
+    if raw is None:
+        return default
+    if isinstance(raw, (dict, list)):
+        return raw
+    try:
+        return json.loads(raw)
+    except Exception:
+        return default
+
+
+def _tail(value: Any) -> str | None:
+    if value is None:
+        return None
+    s = str(value).strip()
+    if not s:
+        return None
+    return s[-2:].zfill(2) if s.isdigit() else s
+
+
+def _walk(value: Any):
+    if isinstance(value, dict):
+        for child in value.values():
+            yield from _walk(child)
+    elif isinstance(value, list):
+        for child in value:
+            yield from _walk(child)
+    elif value is not None:
+        yield str(value)
+
+
+def _family(model: str) -> str:
+    if model in AI_MODELS:
+        return "TOKEN"
+    if model in NO_TOKEN_MODELS:
+        return "NO_TOKEN"
+    return "SHADOW"
+
+
+def _actual_tails(cur: sqlite3.Cursor, date: str, region: str) -> set[str]:
+    rows = cur.execute(
+        "SELECT prizes_json FROM lottery_results WHERE date=? AND region=?",
+        (date, region),
+    ).fetchall()
+    tails: set[str] = set()
+    for row in rows:
+        for raw in _walk(_loads(row["prizes_json"], {})):
+            tail = _tail(raw)
+            if tail:
