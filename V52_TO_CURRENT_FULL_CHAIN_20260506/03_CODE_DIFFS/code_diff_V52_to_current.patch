+def _du_doan_test_actual_axis_sets(region: str, date_str: str) -> dict:
+    """Build actual sets for correct /du-doan-test axis verification.
+
+    Contract:
+    - BT/lo2 use 2-digit tails from the region.
+    - lo3 / 3-cang uses FULL 3-digit suffixes from prize values, not 2-digit tails.
+    - xien2/xien3 require all selected 2-digit tails to appear in the SAME station
+      when station-level rows exist, matching official verifier semantics.
+    """
+    import json as _json
+
+    out = {
+        "tails_2d": set(),
+        "tails_3d": set(),
+        "per_station_2d": {},
+        "known": False,
+    }
+    if not region or not date_str:
+        return out
+    conn = None
+    try:
+        conn = get_connection()
+        cur = conn.cursor()
+        rows = cur.execute(
+            """
+            SELECT station, tail_db, tail_g8, prizes_json
+            FROM lottery_results
+            WHERE date=? AND region=?
+            """,
+            (date_str, region.upper()),
+        ).fetchall()
+
+        def _num_str(v):
+            return "".join(ch for ch in str(v or "") if ch.isdigit())
+
+        def _add_value(station: str, value):
+            s = _num_str(value)
+            if not s:
+                return
+            if len(s) >= 2:
+                tail2 = s[-2:].zfill(2)
+                out["tails_2d"].add(tail2)
+                if station:
+                    out["per_station_2d"].setdefault(station, set()).add(tail2)
+            if len(s) >= 3:
+                out["tails_3d"].add(s[-3:].zfill(3))
+
+        def _walk(v):
+            if isinstance(v, dict):
+                for child in v.values():
+                    yield from _walk(child)
+            elif isinstance(v, list):
+                for child in v:
+                    yield from _walk(child)
+            elif v is not None:
+                yield v
+
+        for row in rows:
+            station = row["station"] if "station" in row.keys() else ""
+            _add_value(station, row["tail_db"] if "tail_db" in row.keys() else None)
+            _add_value(station, row["tail_g8"] if "tail_g8" in row.keys() else None)
+            try:
+                prizes = _json.loads(row["prizes_json"] or "{}")
+            except Exception:
+                prizes = {}
+            for raw in _walk(prizes):
+                _add_value(station, raw)
+        out["known"] = bool(rows)
+    except Exception:
+        pass
+    finally:
+        try:
+            if conn:
+                conn.close()
+        except Exception:
+            pass
+    return out
+
+
+def _du_doan_test_lo3_status(lo3_value, actual_axis_sets: dict) -> str:
+    if not lo3_value:
+        return "N/A"
+    if not actual_axis_sets.get("known"):
+        return "PENDING"
+    s = "".join(ch for ch in str(lo3_value) if ch.isdigit())
+    if len(s) < 3:
+        return "LOSE"
+    return "WIN" if s[-3:].zfill(3) in actual_axis_sets.get("tails_3d", set()) else "LOSE"
+
+
+def _du_doan_test_xien_status(values, actual_axis_sets: dict, required_count: int) -> str:
+    vals = [str(v).zfill(2) for v in (values or []) if v and str(v) != "--"]
+    if len(vals) < required_count:
+        return "N/A"
+    if not actual_axis_sets.get("known"):
+        return "PENDING"
+    per_station = actual_axis_sets.get("per_station_2d") or {}
+    if per_station:
+        for tails in per_station.values():
+            if all(v in tails for v in vals[:required_count]):
+                return "WIN"
+        return "LOSE"
+    tails_2d = actual_axis_sets.get("tails_2d", set())
+    return "WIN" if all(v in tails_2d for v in vals[:required_count]) else "LOSE"
+
+
+def _build_du_doan_test_model_budget_summary(region: str, date_str: str) -> dict:
+    """Read-only C-16 adaptive model budget summary for /du-doan-test UI."""
+    import json as _json
+
+    out = {
+        "status": "NO_BUDGET_ROWS",
+        "date": date_str,
+        "region": (region or "").upper(),
+        "budget": None,
+        "selected_voters": [],
+        "watch_only": [],
+        "skipped": [],
+        "controls": [],
+        "official_output": False,
+        "output_impact": False,
+        "test_only": True,
+        "admin_only": True,
+        "output_eligible": False,
+    }
+    if out["region"] not in ("MN", "MT", "MB"):
+        out["status"] = "INVALID_REGION"
+        return out
+    conn = None
+    try:
+        conn = get_connection()
+        cur = conn.cursor()
+        budget_row = cur.execute(
+            """
+            SELECT *
+            FROM du_doan_test_model_budget_daily
+            WHERE run_date=? AND region=? AND output_type='BT'
+            ORDER BY id DESC
+            LIMIT 1
+            """,
+            (date_str, out["region"]),
+        ).fetchone()
+        if not budget_row:
+            return out
+        budget = dict(budget_row)
+        for col in ("station_set_json", "scoring_weights_json"):
+            try:
+                budget[col.replace("_json", "")] = _json.loads(budget.get(col) or "[]")
+            except Exception:
+                budget[col.replace("_json", "")] = []
+        out["budget"] = budget
+        rows = cur.execute(
+            """
+            SELECT *
+            FROM du_doan_test_selected_voters
+            WHERE budget_id=?
+            ORDER BY model_rank
+            """,
+            (budget["id"],),
+        ).fetchall()
+        selected, watch, skipped, controls = [], [], [], []
+        for r in rows:
+            item = dict(r)
+            try:
+                item["pick_for_date"] = _json.loads(item.get("pick_for_date_json") or "{}")
+            except Exception:
+                item["pick_for_date"] = {}
+            role = item.get("selector_role")
+            if role == "CONTROL":
+                controls.append(item)
+                selected.append(item)
+            elif role == "SELECTED_VOTER":
+                selected.append(item)
+            elif role == "WATCH_ONLY":
+                watch.append(item)
+            else:
+                skipped.append(item)
+        out.update({
+            "status": "READY",
+            "selected_voters": selected,
+            "watch_only": watch,
+            "skipped": skipped,
+            "controls": controls,
+        })
+    except Exception as exc:
+        out["status"] = "BUDGET_SUMMARY_ERROR"
+        out["error"] = str(exc)[:200]
+    finally:
+        try:
+            if conn:
+                conn.close()
+        except Exception:
+            pass
+    return out
+
