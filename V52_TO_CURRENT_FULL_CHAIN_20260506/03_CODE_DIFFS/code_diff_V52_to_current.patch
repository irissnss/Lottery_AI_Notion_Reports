+        # Strong enough to score only if the model has either tensor sample or
+        # a same-day prediction row. Otherwise it remains watch/skip.
+        measured = bool(strength["sample"] or prediction)
+        final = (
+            WEIGHTS["strength"] * strength["score"]
+            + WEIGHTS["recent"] * recent
