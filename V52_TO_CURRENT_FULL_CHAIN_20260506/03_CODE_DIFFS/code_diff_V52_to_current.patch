+def _classify_weekday_rule_strength(bundle_bt_rate: float, ai_top1_win_rate: float) -> str:
+    if bundle_bt_rate >= 0.45 and ai_top1_win_rate >= 0.45:
+        return "STRONG"
+    if bundle_bt_rate >= 0.28 and ai_top1_win_rate >= 0.25:
+        return "SUPPORT"
+    return "WEAK"
+
