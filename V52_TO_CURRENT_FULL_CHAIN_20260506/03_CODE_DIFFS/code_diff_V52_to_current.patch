+            1, 1, 0, 0, 1, _now(),
+        ),
+    )
+    budget_id = int(cur.lastrowid)
+
+    for row in scored:
+        if row["selector_role"] in {"SELECTED_VOTER", "CONTROL"}:
+            selected_rank += 1
+            selected_count += 1
+        elif row["selector_role"] == "WATCH_ONLY":
+            watch_count += 1
+        else:
+            skipped_count += 1
+        if row["selector_role"] == "CONTROL":
+            control_count += 1
+        reason_parts = [
+            f"score={row['final_budget_score']}",
+            f"strength={row['strength']['score']}({row['strength']['grain']},n={row['strength']['sample']})",
+            f"recent={row['recent_score']}",
+            f"unique={row['unique_score']}",
+            f"latency={row['latency_score']}:{row['latency_reason']}",
+            f"region={row['region_penalty_score']}:{row['region_penalty_reason']}",
+        ]
+        cur.execute(
+            """
+            INSERT INTO du_doan_test_selected_voters (
+                budget_id, run_date, region, model_name, model_class, model_role,
+                provider, registry_status, output_eligible, selector_role, control_flag,
+                model_rank, selected_rank, strength_grain, strength_window_days,
