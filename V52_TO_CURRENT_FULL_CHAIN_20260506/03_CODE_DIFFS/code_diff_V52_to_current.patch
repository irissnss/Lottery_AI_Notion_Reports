+def _normalize_measurement_station_name(name: str) -> str:
+    text = str(name or '').strip()
+    return {
+        'HCM': 'TP. HCM',
+        'TPHCM': 'TP. HCM',
+        'TP.HCM': 'TP. HCM',
+        'Hồ Chí Minh': 'TP. HCM',
+        'Thành phố Hồ Chí Minh': 'TP. HCM',
+        'Đắc Lắc': 'Đắk Lắk',
+        'Đắc Nông': 'Đắk Nông',
+        'Thừa Thiên Huế': 'Huế',
+    }.get(text, text)
+
+
+def _get_region_weekday_station_set(cursor, region: str, weekday_idx: int) -> List[str]:
+    sqlite_weekday = (int(weekday_idx) + 1) % 7
+    cursor.execute(
+        """
+        SELECT DISTINCT station
+        FROM lottery_results
+        WHERE region = ? AND CAST(strftime('%w', date) AS INTEGER) = ?
+        ORDER BY station
+        """,
+        (region, sqlite_weekday),
+    )
+    stations = []
+    seen = set()
+    for row in cursor.fetchall():
+        station = _normalize_measurement_station_name(row[0] if not isinstance(row, sqlite3.Row) else row["station"])
+        if station and station not in seen:
+            seen.add(station)
+            stations.append(station)
+    return stations
+
+
+def _bucket_meta_for_trace_row(cursor, row: Dict[str, Any]) -> Dict[str, Any]:
+    region = str(row.get("target_region") or row.get("region") or "").upper()
+    date_val = str(row.get("date") or "").strip()
+    if not region or not date_val:
+        return {
+            "bucket_code": "",
+            "weekday_name": "",
+            "station_set": [],
+            "station_set_label": "",
+        }
+    try:
+        weekday_idx = datetime.strptime(date_val, "%Y-%m-%d").weekday()
+    except Exception:
+        return {
+            "bucket_code": "",
+            "weekday_name": "",
+            "station_set": [],
+            "station_set_label": "",
+        }
+    stations = _get_region_weekday_station_set(cursor, region, weekday_idx)
+    label = ", ".join(stations[:6]) + (" ..." if len(stations) > 6 else "")
+    return {
+        "bucket_code": f"{region}_{WEEKDAY_BUCKET_CODES.get(weekday_idx, '?')}",
+        "weekday_name": WEEKDAY_NAMES_VN.get(weekday_idx, ""),
+        "station_set": stations,
+        "station_set_label": label,
+    }
+
+
+def _rule_source_offset_shift(source_offset: str) -> int:
+    """Normalize mined_rules source_offset strings to weekday deltas."""
+    normalized = str(source_offset or 'D').strip().upper()
+    if normalized in ('D', 'D0', '0'):
+        return 0
+    if normalized in ('D-1', '-1'):
+        return -1
+    if normalized.startswith('D'):
+        try:
+            return int(normalized[1:])
+        except Exception:
+            return 0
+    try:
+        return int(normalized)
+    except Exception:
+        return 0
+
+
+def _format_rule_source_context(target_weekday: int, source_region: str, source_station: str, source_offset: str):
+    """Build an unambiguous source label for Rules UI/API."""
+    shift = _rule_source_offset_shift(source_offset)
+    source_weekday = WEEKDAY_NAMES_VN.get((target_weekday + shift) % 7, '?')
+    source_slot = f"{source_region}({source_offset}/{source_weekday})"
+    source_label = f"{source_slot} · {source_station}"
+    return source_slot, source_label, source_weekday
