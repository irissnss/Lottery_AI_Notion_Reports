+            """,
+            (
+                run_id,
+                str(run["run_date"]),
+                region,
+                exp,
+                exp,
+                json.dumps([m for m in models if _family(m) == "NO_TOKEN"], ensure_ascii=False),
+                int(ranks[0]) if ranks and ranks[0].isdigit() else None,
