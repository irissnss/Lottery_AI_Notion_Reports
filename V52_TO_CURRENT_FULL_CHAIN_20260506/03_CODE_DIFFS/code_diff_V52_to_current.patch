+        return "MODEL_TOP10_ONLY", f"Tail entered candidate pool but rank={candidate_rank}, outside top10 focus."
+    if candidate_rank > 2:
+        return "LOZ_LINE_SELECTION_MISS", f"Tail ranked #{candidate_rank} in candidate pool but official lo2 selected {official_lo2}."
+    return "BUNDLE_PROMOTION_DROP", f"Tail ranked #{candidate_rank} but official lo2 selected {official_lo2}."
+
+
+def materialize_date(date: str, region: str) -> dict[str, Any]:
+    conn = _conn()
+    conn.executescript(SCHEMA_SQL)
+    cur = conn.cursor()
