+        "SELECT * FROM final_bundles WHERE date=? AND region=? ORDER BY id DESC LIMIT 1",
+        (date, region),
+    ).fetchone()
+    if not fb:
+        conn.close()
+        return {"date": date, "region": region, "error": "missing_final_bundle"}
