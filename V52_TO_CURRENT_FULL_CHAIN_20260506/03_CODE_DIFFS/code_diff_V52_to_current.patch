+    pick_first(lambda r: r["model_class"] == "NO_TOKEN" and r["model_role"] == "ML_PREDICTOR")
+    pick_first(lambda r: r["model_role"] == "ENSEMBLE")
+    pick_first(lambda r: r["registry_status"] == "SHADOW_AUTO")
