+    scored.sort(key=lambda x: (x["final_budget_score"], x["strength"]["sample"]), reverse=True)
+
+    # Diversity floors: choose the best output token, no-token, ensemble, and
+    # shadow where available, then fill to target budget from score ranking.
+    selected_names: set[str] = set()
+    controls: set[str] = set()
+
+    def pick_first(predicate):
+        for row in scored:
+            if row["model_name"] not in selected_names and predicate(row):
+                selected_names.add(row["model_name"])
+                controls.add(row["model_name"])
+                return
