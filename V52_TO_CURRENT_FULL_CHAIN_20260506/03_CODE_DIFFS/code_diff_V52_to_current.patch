+def _upstream_results_complete(date_str: str, target_region: str) -> tuple[bool, str]:
+    """Return whether same-day upstream results are complete enough to predict."""
+    from database import get_lottery_results
+    from scraper import validate_prize_card
+
+    target_region = target_region.upper()
+    upstream = {"MT": ["MN"], "MB": ["MN", "MT"]}.get(target_region, [])
+    if not upstream:
+        return True, "no_upstream_required"
+    try:
+        dt = datetime.strptime(date_str, "%Y-%m-%d")
+        parts = []
+        ok = True
+        for up in upstream:
+            rows = get_lottery_results(date_str, up) or []
+            expected = EXPECTED_STATION_COUNT.get((up, dt.weekday()), 0)
+            d2_ok = True
+            for row in rows:
+                if not validate_prize_card(row, up).get("valid"):
+                    d2_ok = False
+                    break
+            part = f"{up}:{len(rows)}/{expected},D2={'OK' if d2_ok else 'BAD'}"
+            parts.append(part)
+            if expected > 0 and (len(rows) < expected or not d2_ok):
+                ok = False
+        return ok, " | ".join(parts)
+    except Exception as e:
+        return False, f"upstream_check_error={e}"
+
