+            except Exception:
+                b["lo2_list"] = []
+            result["official"] = b
+
+        actual_tails = set()
+        actual_rows = cur.execute(
+            """
+            SELECT tail_db, tail_g8, prizes_json
+            FROM lottery_results
+            WHERE date=? AND region=?
+            """,
+            (date_str, region),
+        ).fetchall()
+
+        def _tail2(v):
+            s = "".join(ch for ch in str(v or "") if ch.isdigit())
+            return s[-2:].zfill(2) if s else ""
+
+        def _walk(v):
+            if isinstance(v, dict):
+                for child in v.values():
+                    yield from _walk(child)
+            elif isinstance(v, list):
+                for child in v:
+                    yield from _walk(child)
+            elif v is not None:
+                yield v
+
+        for row in actual_rows:
+            for direct in (row["tail_db"], row["tail_g8"]):
+                t = _tail2(direct)
+                if t:
+                    actual_tails.add(t)
+            try:
+                prizes = _json.loads(row["prizes_json"] or "{}")
+            except Exception:
+                prizes = {}
+            for raw in _walk(prizes):
+                t = _tail2(raw)
+                if t:
+                    actual_tails.add(t)
+        result["actual"] = {
+            "known": bool(actual_tails),
