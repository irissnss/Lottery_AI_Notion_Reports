+                source_scores, in_official_lo2, shared_candidate_pool,
+                shared_selection_reason, independent_signal, leakage_status,
+                verdict, created_at
+            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
+            """,
+            (
+                run_id,
+                str(run["run_date"]),
+                region,
+                exp,
+                test_bt,
+                json.dumps(models, ensure_ascii=False),
+                json.dumps(families, ensure_ascii=False),
+                json.dumps(tables, ensure_ascii=False),
+                json.dumps(ranks, ensure_ascii=False),
+                "not_persisted_in_v49_candidate_layer",
+                in_official_lo2,
+                1 if shared_pool else 0,
+                "all V46/V49 experiments derive from the same candidate_ranked_json pool" if shared_pool else "pool signature differs",
+                independent,
+                leakage_status,
+                verdict,
+                now_vn(),
+            ),
+        )
+        rows_written += 1
+
+        method_verdict = "NOT_PROVEN"
+        if exp == "MB_NO_TOKEN_HERD_REDUCTION_V1":
+            method_verdict = "LOGICAL_CLONE_ONLY"
+        elif exp == "MB_TIER_AWARE_BUNDLE_SHADOW_V1":
+            method_verdict = "PLACEHOLDER_ONLY"
+        elif exp == "MB_PRIOR_REGION_CONTEXT_SAFE_V1":
+            method_verdict = "NO_LEAKAGE_VERIFIED"
+        elif exp == "MB_AI_CHAIN_PRESERVATION_V1":
+            method_verdict = "ACTIVE_TEST_METHOD"
+        elif exp == "MB_COMPOSITE_CHALLENGER_V2":
+            method_verdict = "ACTIVE_TEST_METHOD"
+
+        cur.execute(
+            """
+            INSERT OR REPLACE INTO du_doan_test_conversion_trace (
+                run_id, run_date, region, experiment_name, method_name,
+                source_no_token_models, original_rank, original_score,
