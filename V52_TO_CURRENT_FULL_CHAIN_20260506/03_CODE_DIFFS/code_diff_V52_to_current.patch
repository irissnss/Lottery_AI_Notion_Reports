+        model_role = model.get("role") or ""
+        provider = model.get("provider") or ""
+        status = model.get("status") or ""
+        output_eligible = 1 if model.get("output_eligible") else 0
+        strength = _strength_score(cur, anchor=anchor, date=date, region=region, weekday=weekday, stations=stations, model=model_id)
+        recent = _recent_score(cur, anchor=anchor, region=region, model=model_id)
+        unique, unique_meta = _unique_score(cur, region=region, model=model_id)
+        latency, latency_reason = _latency_score(cur, date=date, region=region, model=model_id)
+        penalty, penalty_reason = _region_penalty_score(region, model_id, model_class, unique_meta)
+        prediction = _prediction_for_date(cur, date, region, model_id)
