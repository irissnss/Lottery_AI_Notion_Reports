+def _get_ai_policy_for_region_weekday(region: str, weekday_name: str) -> str:
+    weekday_name = (weekday_name or "").strip().lower()
+    policy_map = {
+        "MN": {
+            "monday": "AI_PRIMARY",
+            "tuesday": "AI_PRIMARY",
+            "wednesday": "AI_SUPPORT",
+            "thursday": "AI_PRIMARY",
+            "friday": "AI_BLOCKED",
+            "saturday": "AI_PRIMARY",
+            "sunday": "AI_PRIMARY",
+        },
+        "MT": {
+            "monday": "AI_SUPPORT",
+            "tuesday": "AI_SUPPORT",
+            "wednesday": "AI_BLOCKED",
+            "thursday": "AI_PRIMARY",
+            "friday": "AI_BLOCKED",
+            "saturday": "AI_SUPPORT",
+            "sunday": "AI_SUPPORT",
+        },
+        "MB": {
+            "monday": "AI_BLOCKED",
+            "tuesday": "AI_SUPPORT",
+            "wednesday": "AI_BLOCKED",
+            "thursday": "AI_BLOCKED",
+            "friday": "AI_BLOCKED",
+            "saturday": "AI_SUPPORT",
+            "sunday": "AI_BLOCKED",
+        },
+    }
+    return policy_map.get(region.upper(), {}).get(weekday_name, "AI_SUPPORT")
+
