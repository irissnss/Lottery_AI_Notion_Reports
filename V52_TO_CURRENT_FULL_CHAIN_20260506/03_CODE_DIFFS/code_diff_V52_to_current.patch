+def _parse_ai_json_payload(result_text: str) -> dict:
+    """Parse model JSON payload with markdown/trailing-text recovery."""
+    if "```json" in result_text:
+        start = result_text.find("```json") + 7
+        end = result_text.find("```", start)
+        if end > start:
+            result_text = result_text[start:end].strip()
+        else:
+            result_text = result_text[start:].strip()
+            print(f"[JSON] Stripped opening ```json (no closing ``` — likely max_tokens truncation)")
+    elif "```" in result_text:
+        start = result_text.find("```") + 3
+        end = result_text.find("```", start)
+        if end > start:
+            result_text = result_text[start:end].strip()
+        else:
+            result_text = result_text[start:].strip()
+            print(f"[JSON] Stripped opening ``` (no closing ``` — likely max_tokens truncation)")
+
+    try:
+        return json.loads(result_text)
+    except json.JSONDecodeError as e:
+        if "Extra data" in str(e):
+            print(f"[JSON] Extra data detected at char {e.pos}, trying to extract first JSON object")
+            depth = 0
+            json_end = -1
+            in_string = False
+            escape = False
+            for i, ch in enumerate(result_text):
+                if escape:
+                    escape = False
+                    continue
+                if ch == '\\' and in_string:
+                    escape = True
+                    continue
+                if ch == '"' and not escape:
+                    in_string = not in_string
+                    continue
+                if in_string:
+                    continue
+                if ch == '{':
+                    depth += 1
+                elif ch == '}':
+                    depth -= 1
+                    if depth == 0:
+                        json_end = i + 1
+                        break
+
+            if json_end > 0:
+                trimmed = result_text[:json_end]
+                print(f"[JSON] Extracted {len(trimmed)} chars (trimmed {len(result_text) - json_end} trailing chars)")
+                return json.loads(trimmed)
+
+            decoder = json.JSONDecoder()
+            result, _ = decoder.raw_decode(result_text)
