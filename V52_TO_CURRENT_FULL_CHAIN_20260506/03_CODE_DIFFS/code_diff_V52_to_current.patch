+def _mb_ai_chain_in_progress(date_str: str) -> bool:
+    """Best-effort check to avoid watchdog duplicate while AI chain is running."""
+    from database import get_connection
+
+    conn = get_connection()
+    try:
+        cur = conn.cursor()
+        cur.execute(
+            """
+            SELECT
+                MAX(CASE WHEN message LIKE '%[CASCADE_STAGE_START] region=MB stage=AI_CHAIN%' THEN id ELSE 0 END) AS start_id,
+                MAX(CASE WHEN message LIKE '%[CASCADE_STAGE_END] region=MB stage=AI_CHAIN%' THEN id ELSE 0 END) AS end_id
+            FROM scheduler_logs
+            WHERE date_str=? OR message LIKE ?
+            """,
+            (date_str, f"%MB ({date_str})%"),
+        )
+        row = cur.fetchone()
+        start_id = int(row["start_id"] or 0)
+        end_id = int(row["end_id"] or 0)
+        return start_id > end_id
+    finally:
+        conn.close()
