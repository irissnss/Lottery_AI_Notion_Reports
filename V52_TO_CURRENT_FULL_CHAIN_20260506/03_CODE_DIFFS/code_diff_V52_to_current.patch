+            hits.append({
+                "model": row["ai_model"],
+                "family": _family(str(row["ai_model"])),
+                "run_source": row["run_source"] or "",
+                "rank": nums.index(tail) + 1,
+                "strength": row["strength"],
+                "verdict": row["verdict"],
