+    if not actual:
+        conn.close()
+        return {"date": date, "region": region, "error": "missing_actual_results"}
+    official_bt = _tail(fb["bach_thu"])
+    official_lo2 = [_tail(v) for v in _loads(fb["lo2"], [])]
+    official_lo2 = [v for v in official_lo2 if v]
+    source_payload = _loads(fb["source_predictions_json"], {})
+    written = 0
+    for tail in actual:
+        hits = _model_hits(cur, date, region, tail)
+        cand_rank, cand_score = _candidate_rank(source_payload, tail)
+        stage, reason = _drop_stage(tail=tail, hits=hits, candidate_rank=cand_rank, official_lo2=official_lo2)
+        ranks = [h["rank"] for h in hits]
+        predicted_rank = min(ranks) if ranks else None
+        cur.execute(
+            """
+            INSERT OR REPLACE INTO loz_stage_trace_shadow (
+                date, region, actual_tail, output_axis,
+                model_names_json, model_families_json, run_sources_json, predicted_rank,
+                in_top1, in_top2, in_top5, in_top10,
+                candidate_pool_present, candidate_score_rank, candidate_score, bundle_rank,
+                final_loz1_selected, final_loz2_selected, drop_stage, drop_reason,
+                official_bt, official_lo2_json, diagnostic_only, shadow_only, output_eligible,
+                created_at
+            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
+            """,
+            (
+                date, region, tail, "LO2",
+                json.dumps([h["model"] for h in hits], ensure_ascii=False),
+                json.dumps(sorted({h["family"] for h in hits}), ensure_ascii=False),
+                json.dumps(sorted({h["run_source"] for h in hits}), ensure_ascii=False),
+                predicted_rank,
+                1 if predicted_rank == 1 else 0,
+                1 if predicted_rank and predicted_rank <= 2 else 0,
+                1 if predicted_rank and predicted_rank <= 5 else 0,
+                1 if predicted_rank and predicted_rank <= 10 else 0,
+                1 if cand_rank is not None else 0,
+                cand_rank,
+                cand_score,
+                cand_rank,
+                official_lo2[0] if len(official_lo2) >= 1 else None,
+                official_lo2[1] if len(official_lo2) >= 2 else None,
+                stage,
+                reason,
+                official_bt,
+                json.dumps(official_lo2, ensure_ascii=False),
+                1, 1, 0,
+                _now(),
+            ),
+        )
+        written += 1
+    conn.commit()
+    conn.close()
+    return {"date": date, "region": region, "rows_written": written, "actual_tails": len(actual)}
+
+
+def backfill(days: int, *, anchor_date: str | None = None) -> dict[str, Any]:
+    conn = _conn()
+    if not anchor_date:
+        row = conn.execute("SELECT MAX(date) FROM final_bundles WHERE bach_thu_status IN ('WIN','LOSE','PARTIAL')").fetchone()
+        anchor_date = row[0] if row else None
+    if not anchor_date:
+        conn.close()
+        return {"error": "no_closed_bundle_date"}
+    rows = conn.execute(
+        "SELECT DISTINCT date, region FROM final_bundles WHERE date >= date(?, ?) AND date <= ? ORDER BY date, region",
+        (anchor_date, f"-{days - 1} days", anchor_date),
+    ).fetchall()
+    conn.close()
+    return {
+        "anchor_date": anchor_date,
+        "days": days,
+        "results": [materialize_date(r["date"], r["region"]) for r in rows],
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--date")
+    parser.add_argument("--region", choices=("MN", "MT", "MB"))
+    parser.add_argument("--backfill-days", type=int, default=0)
+    parser.add_argument("--anchor-date")
+    parser.add_argument("--json", action="store_true")
+    args = parser.parse_args(argv)
+    if args.backfill_days:
+        result = backfill(args.backfill_days, anchor_date=args.anchor_date)
+    else:
+        if not args.date or not args.region:
+            result = {"error": "--date and --region are required unless --backfill-days is used"}
+        else:
+            result = materialize_date(args.date, args.region)
+    print(json.dumps(result, ensure_ascii=False, indent=2 if args.json else None))
+    return 0 if not result.get("error") else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())

