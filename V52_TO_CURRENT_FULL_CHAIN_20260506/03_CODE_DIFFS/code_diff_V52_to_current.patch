+def _record_draw_availability(date_str: str, region: str, notes: str = None) -> dict:
+    """Persist Predict-Always / Verify-Later availability state.
+
+    Diagnostic-only. Does not influence scoring or output policy.
+    """
+    from database import get_connection
+    import json as _json
+
+    region = region.upper()
+    conn = get_connection()
+    try:
+        _ensure_draw_availability_table(conn)
+        cur = conn.cursor()
+        cur.execute(
+            """
+            SELECT run_source, COUNT(*) AS rows, COUNT(DISTINCT ai_model) AS models
+            FROM predictions
+            WHERE date=? AND target_region=?
+            GROUP BY run_source
+            """,
+            (date_str, region),
+        )
+        by_source = {str(r["run_source"] or ""): int(r["rows"] or 0) for r in cur.fetchall()}
+        raw_ai_chain_rows = by_source.get("ai_chain", 0)
+        auto_daily_rows = by_source.get("auto_daily", 0)
+        ai_chain_rows = raw_ai_chain_rows + auto_daily_rows if region == "MN" else raw_ai_chain_rows
+        rerun_rows = sum(v for k, v in by_source.items() if k.startswith("rerun_post_"))
+        shadow_rows = by_source.get("shadow_auto_eval", 0)
+
+        cur.execute(
+            "SELECT COUNT(*) AS cnt FROM final_bundles WHERE date=? AND region=?",
+            (date_str, region),
+        )
+        final_bundle_exists = 1 if int(cur.fetchone()["cnt"] or 0) > 0 else 0
+
+        cur.execute(
+            "SELECT COUNT(*) AS cnt FROM lottery_results WHERE date=? AND region=?",
+            (date_str, region),
+        )
+        result_rows = int(cur.fetchone()["cnt"] or 0)
+
+        try:
+            dt = datetime.strptime(date_str, "%Y-%m-%d")
+            expected_station_count = EXPECTED_STATION_COUNT.get((region, dt.weekday()), 0)
+        except Exception:
+            expected_station_count = 0
+
+        cur.execute(
+            """
+            SELECT COUNT(*) AS cnt
+            FROM scheduler_logs
+            WHERE date_str=? AND region=? AND (
+                message LIKE '%Bắt đầu auto-update%'
+                OR message LIKE '%Đã cào%'
+                OR message LIKE '%DATA_REFRESH_GATE%'
+                OR message LIKE '%PRIZE_CARD%'
+            )
+            """,
+            (date_str, region),
+        )
+        scrape_attempted = 1 if int(cur.fetchone()["cnt"] or 0) > 0 or result_rows > 0 else 0
+
+        if result_rows >= expected_station_count and expected_station_count > 0:
+            result_status = "RESULT_CONFIRMED"
+        elif result_rows > 0:
+            result_status = "PARTIAL_RESULT"
+        elif scrape_attempted:
+            result_status = "NO_RESULT_SUSPECTED"
+        else:
+            result_status = "AWAITING_SCRAPE"
+
+        if region == "MN":
+            prediction_completed = 1 if final_bundle_exists else 0
+        elif region in ("MT", "MB"):
+            prediction_completed = 1 if ai_chain_rows >= 8 and final_bundle_exists else 0
+        else:
+            prediction_completed = 1 if final_bundle_exists else 0
+
+        holiday_advisory = 1 if is_lottery_holiday_advisory(date_str, region) else 0
+        payload = {
+            "date": date_str,
+            "region": region,
+            "holiday_advisory": holiday_advisory,
+            "prediction_required": 1,
+            "prediction_completed": prediction_completed,
+            "ai_chain_rows": ai_chain_rows,
+            "rerun_rows": rerun_rows,
+            "shadow_rows": shadow_rows,
+            "final_bundle_exists": final_bundle_exists,
+            "scrape_attempted": scrape_attempted,
+            "result_rows": result_rows,
+            "expected_station_count": expected_station_count,
+            "result_status": result_status,
+            "verify_status": "VERIFIED" if result_status == "RESULT_CONFIRMED" else "PENDING",
+            "notes": notes,
+            "raw_ai_chain_rows": raw_ai_chain_rows,
+            "auto_daily_rows": auto_daily_rows,
+        }
+
+        cur.execute(
+            """
+            INSERT INTO draw_availability_daily (
+                date, region, holiday_advisory, prediction_required, prediction_completed,
+                ai_chain_rows, rerun_rows, shadow_rows, final_bundle_exists,
+                scrape_attempted, result_rows, expected_station_count,
+                result_status, verify_status, notes, updated_at
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))
+            ON CONFLICT(date, region) DO UPDATE SET
+                holiday_advisory=excluded.holiday_advisory,
+                prediction_required=excluded.prediction_required,
+                prediction_completed=excluded.prediction_completed,
+                ai_chain_rows=excluded.ai_chain_rows,
+                rerun_rows=excluded.rerun_rows,
+                shadow_rows=excluded.shadow_rows,
+                final_bundle_exists=excluded.final_bundle_exists,
+                scrape_attempted=excluded.scrape_attempted,
+                result_rows=excluded.result_rows,
+                expected_station_count=excluded.expected_station_count,
+                result_status=excluded.result_status,
+                verify_status=excluded.verify_status,
+                notes=excluded.notes,
+                updated_at=datetime('now')
+            """,
+            (
+                date_str, region, holiday_advisory, 1, prediction_completed,
+                ai_chain_rows, rerun_rows, shadow_rows, final_bundle_exists,
+                scrape_attempted, result_rows, expected_station_count,
+                result_status, payload["verify_status"], notes,
+            ),
+        )
+        conn.commit()
+        # Keep a compact JSON note available for ad-hoc debugging in logs.
+        payload["run_sources_json"] = _json.dumps(by_source, ensure_ascii=False)
+        return payload
+    finally:
+        conn.close()
