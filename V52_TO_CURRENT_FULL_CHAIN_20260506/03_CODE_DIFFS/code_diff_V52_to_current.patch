+def _registry_pool() -> list[dict[str, Any]]:
+    from model_registry import MODEL_REGISTRY
+
+    pool = []
+    for item in MODEL_REGISTRY:
+        if item.get("status") == "REMOVED":
+            continue
+        model_id = item.get("id")
+        # Exclude non-prediction utility entries from voter pool; keep Cohere
+        # rerank only as WATCH_ONLY if present.
+        if model_id in {"wan-2.7", "pplx-embed-v1"}:
+            continue
