+def _extract_source_prize_tokens(trace_row: Dict[str, Any]) -> List[str]:
+    tokens: List[str] = []
+    for item in trace_row.get("selected_source_prizes") or []:
+        if isinstance(item, dict):
+            region = str(item.get("region") or "").strip()
+            prize = str(item.get("prize") or item.get("prize_key") or "").strip()
+            number = str(item.get("number") or "").strip()
+            token = "|".join(part for part in [region, prize, number] if part)
+            if token:
+                tokens.append(token)
+        elif isinstance(item, str) and item.strip():
+            tokens.append(item.strip())
+    for item in trace_row.get("strongest_source_prizes_used") or []:
+        if isinstance(item, str) and item.strip():
+            tokens.append(item.strip())
+        elif isinstance(item, dict):
+            region = str(item.get("region") or "").strip()
+            prize = str(item.get("prize") or item.get("prize_key") or "").strip()
+            number = str(item.get("number") or "").strip()
+            token = "|".join(part for part in [region, prize, number] if part)
+            if token:
+                tokens.append(token)
+    seen = set()
+    ordered = []
+    for token in tokens:
+        if token not in seen:
+            seen.add(token)
+            ordered.append(token)
+    return ordered
+
