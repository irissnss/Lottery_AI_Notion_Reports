+def _attach_owner_priority_meta(source_data: dict, target_region: str, date_str: str) -> dict:
+    """Attach owner-doctrine priority metadata so prompts show real source order."""
+    if not source_data:
+        return source_data
+    from datetime import datetime as _dt, timedelta as _td
+    target_dt = _dt.strptime(date_str, "%Y-%m-%d")
+    prev_date_str = (target_dt - _td(days=1)).strftime("%Y-%m-%d")
+
+    specs = {
+        "MN": [
+            ("MN_D1", f"MN(D-1) {prev_date_str}"),
+            ("MT_D1", f"MT(D-1) {prev_date_str}"),
+            ("MB_D1", f"MB(D-1) {prev_date_str}"),
+        ],
+        "MT": [
+            ("MN_D1", f"MN(D-1) {prev_date_str}"),
+            ("MT_D1", f"MT(D-1) {prev_date_str}"),
+            ("MB_D1", f"MB(D-1) {prev_date_str}"),
+            ("MN", f"MN(D) {date_str}"),
+        ],
+        "MB": [
+            ("MN_D1", f"MN(D-1) {prev_date_str}"),
+            ("MT_D1", f"MT(D-1) {prev_date_str}"),
+            ("MB_D1", f"MB(D-1) {prev_date_str}"),
+            ("MN", f"MN(D) {date_str}"),
+            ("MT", f"MT(D) {date_str}"),
+        ],
+    }.get((target_region or "").upper(), [])
+
+    priority_meta = {}
+    for idx, (key, label) in enumerate(specs, start=1):
+        if key in source_data and source_data.get(key):
+            priority_meta[key] = {"priority": idx, "label": label}
+    if priority_meta:
+        source_data["_priority_meta"] = priority_meta
+    return source_data
 
 
