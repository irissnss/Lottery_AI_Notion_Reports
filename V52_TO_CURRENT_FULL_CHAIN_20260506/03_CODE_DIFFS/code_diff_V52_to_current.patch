+def table_digest(conn: sqlite3.Connection, table: str) -> dict[str, Any]:
+    cur = conn.cursor()
+    if not table_exists(cur, table):
+        return {"exists": False, "count": 0, "sha256": "NA"}
+    cols = [row[1] for row in cur.execute(f"PRAGMA table_info({table})").fetchall()]
+    order_col = "id" if "id" in cols else "rowid"
+    h = hashlib.sha256()
+    count = 0
+    for row in cur.execute(f"SELECT * FROM {table} ORDER BY {order_col}"):
+        h.update(json.dumps(list(row), ensure_ascii=False, default=str).encode("utf-8"))
+        h.update(b"\n")
+        count += 1
+    return {"exists": True, "count": count, "sha256": h.hexdigest()}
