+            "model_name": model_id,
+            "model_class": model_class,
+            "model_role": model_role,
+            "provider": provider,
+            "registry_status": status,
+            "output_eligible": output_eligible,
+            "strength": strength,
+            "recent_score": recent,
+            "unique_score": unique,
+            "unique_meta": unique_meta,
+            "latency_score": latency,
+            "latency_reason": latency_reason,
+            "region_penalty_score": penalty,
+            "region_penalty_reason": penalty_reason,
+            "final_budget_score": round(max(0.0, min(1.0, final)), 4),
+            "prediction": prediction,
