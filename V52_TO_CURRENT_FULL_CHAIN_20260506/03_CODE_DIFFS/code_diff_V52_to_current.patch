+"""V52.5.1 model strength tensor builder (measurement-only).
+
+Builds rolling strength snapshots for each model across `region`, `weekday`,
+`station`, and `run_source`. Used by the test-lane engine to apply
+strength-weighted aggregation without touching official `/du-doan` output.
+
+Hard contract:
+- Reads only from `predictions`, `model_daily_eval`, and `lottery_results`.
+- Writes only to `model_strength_by_region_weekday_station_daily`.
+- Does NOT call `generate_final_bundle()`.
+- Does NOT mutate `final_bundles`, production `predictions`, official scoring,
+  bundle voting, prompt, model roster, or scheduler.
+- Anchor date defaults to "yesterday" relative to the requested target date so
+  the snapshot is live-available for test selections on the target date.
+"""
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import json
+import sqlite3
+import sys
+from collections import defaultdict
+from pathlib import Path
+from typing import Any, Iterable
+
+ROOT = Path(__file__).resolve().parents[2]
+DB_PATH = ROOT / "data" / "lottery_ai.db"
+
+AI_MODELS = {
+    "gpt-5-mini", "claude-sonnet-4-6", "gemini-2.5-flash",
+    "claude-opus-4-20250514", "deepseek-reasoner", "gemini-2.5-pro",
+    "gpt-5.4", "combo-super",
+}
+NO_TOKEN_MODELS = {
+    "meta-learning", "lstm", "xgboost", "random-forest",
+    "smart-ensemble", "smart-ml", "combo-no-token",
+}
+
+WINDOWS = (7, 14, 30, 60)
+GRAINS = ("region", "region_weekday", "region_station")
+ALL_WEEKDAY = -1
+ALL_TOKEN = ""
+
+SCHEMA_SQL = """
+CREATE TABLE IF NOT EXISTS model_strength_by_region_weekday_station_daily (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    computed_at TEXT NOT NULL,
+    anchor_date TEXT NOT NULL,
+    window_days INTEGER NOT NULL,
+    grain TEXT NOT NULL,
+    model_name TEXT NOT NULL,
+    model_family TEXT,
+    region TEXT NOT NULL,
+    weekday INTEGER NOT NULL DEFAULT -1,
+    station TEXT NOT NULL DEFAULT '',
+    run_source TEXT NOT NULL DEFAULT '',
+    total_days INTEGER DEFAULT 0,
+    predictions_count INTEGER DEFAULT 0,
+    bt_hit_count INTEGER DEFAULT 0,
+    loz1_hit_count INTEGER DEFAULT 0,
+    loz2_hit_count INTEGER DEFAULT 0,
+    any_hit_count INTEGER DEFAULT 0,
+    bt_rate REAL,
+    loz1_rate REAL,
+    loz2_rate REAL,
+    any_rate REAL,
+    helpful_signal_strength REAL,
+    test_only INTEGER DEFAULT 1,
+    output_eligible INTEGER DEFAULT 0,
+    diagnostic_only INTEGER DEFAULT 1,
+    run_label TEXT NOT NULL,
+    UNIQUE(anchor_date, window_days, grain, model_name, region, weekday, station, run_source, run_label)
+);
+
+CREATE INDEX IF NOT EXISTS idx_strength_anchor_window
+    ON model_strength_by_region_weekday_station_daily(anchor_date, window_days);
+CREATE INDEX IF NOT EXISTS idx_strength_lookup
+    ON model_strength_by_region_weekday_station_daily(model_name, region, weekday, station, run_source);
+"""
+
+
+def _now() -> str:
+    return dt.datetime.now(dt.timezone(dt.timedelta(hours=7))).isoformat(timespec="seconds")
+
+
+def _conn() -> sqlite3.Connection:
+    conn = sqlite3.connect(DB_PATH)
+    conn.row_factory = sqlite3.Row
+    return conn
+
+
+def _family(model_name: str) -> str:
+    if model_name in AI_MODELS:
+        return "TOKEN"
+    if model_name in NO_TOKEN_MODELS:
+        return "NO_TOKEN"
+    return "SHADOW"
+
+
+def _loads(raw: Any, default: Any) -> Any:
+    if raw is None:
+        return default
+    if isinstance(raw, (dict, list)):
+        return raw
+    try:
+        return json.loads(raw)
+    except Exception:
+        return default
+
+
+def _tail(value: Any) -> str | None:
+    if value is None:
+        return None
+    s = str(value).strip()
+    if not s:
+        return None
+    return s[-2:].zfill(2) if s.isdigit() else s
+
+
+def _walk(value: Any) -> Iterable[str]:
+    if isinstance(value, dict):
+        for child in value.values():
+            yield from _walk(child)
+    elif isinstance(value, list):
+        for child in value:
+            yield from _walk(child)
+    elif value is not None:
+        yield str(value)
+
+
+def _date_iter(anchor_date: str, window_days: int) -> list[str]:
+    anchor = dt.date.fromisoformat(anchor_date)
+    start = anchor - dt.timedelta(days=window_days - 1)
+    return [(start + dt.timedelta(days=i)).isoformat() for i in range(window_days)]
+
+
+def _fetch_window(cur: sqlite3.Cursor, dates: list[str]):
+    if not dates:
+        return [], []
+    qmarks = ",".join("?" * len(dates))
+    pred_rows = cur.execute(
+        f"""
+        SELECT date, target_region AS region, ai_model, run_source, main_numbers
+        FROM predictions
+        WHERE date IN ({qmarks})
+        """,
+        dates,
+    ).fetchall()
+    lottery_rows = cur.execute(
+        f"""
+        SELECT date, region, station, prizes_json
+        FROM lottery_results
+        WHERE date IN ({qmarks})
+        """,
+        dates,
+    ).fetchall()
+    return pred_rows, lottery_rows
+
+
+def _build_actuals(lottery_rows) -> tuple[dict[tuple[str, str], set[str]], dict[tuple[str, str, str], set[str]]]:
+    region_tails: dict[tuple[str, str], set[str]] = defaultdict(set)
+    station_tails: dict[tuple[str, str, str], set[str]] = defaultdict(set)
+    for row in lottery_rows:
+        prizes = _loads(row["prizes_json"], {})
+        for raw in _walk(prizes):
+            t = _tail(raw)
+            if not t:
+                continue
+            region_tails[(row["date"], row["region"])].add(t)
+            station_tails[(row["date"], row["region"], row["station"])].add(t)
+    return region_tails, station_tails
+
+
+def _aggregate(pred_rows, region_tails, station_tails, *, grain: str) -> dict[tuple, dict[str, int]]:
+    """Return {key -> counts}.
+
+    Region grain key: (model, family, region, run_source)
+    Region+weekday grain key: (model, family, region, weekday, run_source)
+    Region+station grain key: (model, family, region, station, run_source)
+    """
+    counts: dict[tuple, dict[str, int]] = defaultdict(lambda: {
+        "predictions_count": 0, "bt_hit_count": 0, "loz1_hit_count": 0,
+        "loz2_hit_count": 0, "any_hit_count": 0, "_dates": set(),
+    })
+    for row in pred_rows:
+        date = row["date"]
+        region = row["region"]
+        model = row["ai_model"]
+        run_source = row["run_source"] or ""
+        nums = [t for t in (_tail(x) for x in _loads(row["main_numbers"], [])) if t]
+        if not nums:
+            continue
+        family = _family(model)
+        actual_region = region_tails.get((date, region), set())
+        if grain == "region":
+            keys = [(model, family, region, run_source)]
+        elif grain == "region_weekday":
+            wd = dt.date.fromisoformat(date).weekday()
+            keys = [(model, family, region, wd, run_source)]
+        elif grain == "region_station":
+            keys = []
+            for (d, r, station), _tails in station_tails.items():
+                if d == date and r == region:
+                    keys.append((model, family, region, station, run_source))
+            if not keys:
+                continue
+        else:
+            continue
+        for key in keys:
+            entry = counts[key]
+            entry["_dates"].add(date)
+            entry["predictions_count"] += 1
+            top1 = nums[0]
+            top2 = nums[1] if len(nums) > 1 else None
+            if grain == "region_station":
+                station = key[3]
+                actual = station_tails.get((date, region, station), set())
+            else:
+                actual = actual_region
+            if top1 in actual:
+                entry["bt_hit_count"] += 1
+                entry["loz1_hit_count"] += 1
+            if top2 and top2 in actual:
+                entry["loz2_hit_count"] += 1
+            if (top1 in actual) or (top2 and top2 in actual):
+                entry["any_hit_count"] += 1
+    return counts
+
+
+def materialize(anchor_date: str, *, run_label: str | None = None) -> dict[str, Any]:
+    label = run_label or f"v52_5_1_strength_tensor_{anchor_date}"
+    conn = _conn()
+    conn.executescript(SCHEMA_SQL)
+    cur = conn.cursor()
+    computed_at = _now()
+    written = 0
+    skipped_existing = 0
+
+    for window_days in WINDOWS:
+        dates = _date_iter(anchor_date, window_days)
+        pred_rows, lottery_rows = _fetch_window(cur, dates)
+        region_tails, station_tails = _build_actuals(lottery_rows)
+        for grain in GRAINS:
+            agg = _aggregate(pred_rows, region_tails, station_tails, grain=grain)
+            for key, counts in agg.items():
+                if grain == "region":
+                    model, family, region, run_source = key
+                    weekday = ALL_WEEKDAY
+                    station = ALL_TOKEN
+                elif grain == "region_weekday":
+                    model, family, region, weekday, run_source = key
+                    station = ALL_TOKEN
+                else:
+                    model, family, region, station, run_source = key
+                    weekday = ALL_WEEKDAY
+                total_days = len(counts["_dates"])
+                pred_n = counts["predictions_count"]
+                if pred_n == 0:
+                    continue
+                bt_rate = counts["bt_hit_count"] / pred_n if pred_n else None
+                loz1_rate = counts["loz1_hit_count"] / pred_n if pred_n else None
+                loz2_rate = counts["loz2_hit_count"] / pred_n if pred_n else None
+                any_rate = counts["any_hit_count"] / pred_n if pred_n else None
+                helpful = round((bt_rate or 0) * 0.6 + (loz2_rate or 0) * 0.4, 4)
+                exists = cur.execute(
+                    """
+                    SELECT 1 FROM model_strength_by_region_weekday_station_daily
+                    WHERE anchor_date=? AND window_days=? AND grain=? AND model_name=?
+                      AND region=? AND weekday=? AND station=? AND run_source=? AND run_label=?
+                    """,
+                    (anchor_date, window_days, grain, model, region, weekday, station, run_source, label),
+                ).fetchone()
+                if exists:
+                    skipped_existing += 1
+                    continue
+                cur.execute(
+                    """
+                    INSERT INTO model_strength_by_region_weekday_station_daily (
+                        computed_at, anchor_date, window_days, grain, model_name,
+                        model_family, region, weekday, station, run_source,
+                        total_days, predictions_count, bt_hit_count, loz1_hit_count,
+                        loz2_hit_count, any_hit_count, bt_rate, loz1_rate, loz2_rate,
+                        any_rate, helpful_signal_strength, test_only, output_eligible,
+                        diagnostic_only, run_label
+                    ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
+                    """,
+                    (
+                        computed_at, anchor_date, window_days, grain, model,
+                        family, region, weekday, station, run_source,
+                        total_days, pred_n, counts["bt_hit_count"], counts["loz1_hit_count"],
+                        counts["loz2_hit_count"], counts["any_hit_count"],
+                        round(bt_rate, 4) if bt_rate is not None else None,
+                        round(loz1_rate, 4) if loz1_rate is not None else None,
+                        round(loz2_rate, 4) if loz2_rate is not None else None,
+                        round(any_rate, 4) if any_rate is not None else None,
+                        helpful,
+                        1, 0, 1, label,
+                    ),
+                )
+                written += 1
+    conn.commit()
+    conn.close()
+    return {
+        "anchor_date": anchor_date,
+        "run_label": label,
+        "rows_written": written,
+        "rows_skipped_existing": skipped_existing,
+        "windows": list(WINDOWS),
+        "grains": list(GRAINS),
+        "official_output": False,
+        "output_impact": False,
+        "output_eligible": False,
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--anchor-date", help="Anchor date YYYY-MM-DD (defaults to yesterday VN time)")
+    parser.add_argument("--target-date", help="Compute anchor as target_date - 1")
+    parser.add_argument("--run-label")
+    parser.add_argument("--json", action="store_true")
+    args = parser.parse_args(argv)
+    if args.target_date:
+        anchor = (dt.date.fromisoformat(args.target_date) - dt.timedelta(days=1)).isoformat()
+    elif args.anchor_date:
+        anchor = args.anchor_date
+    else:
+        anchor = (dt.datetime.now(dt.timezone(dt.timedelta(hours=7))).date() - dt.timedelta(days=1)).isoformat()
+    result = materialize(anchor, run_label=args.run_label)
+    if args.json:
+        print(json.dumps(result, ensure_ascii=False, indent=2))
+    else:
+        print(result)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

