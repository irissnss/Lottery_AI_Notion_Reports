+            leakage_status = "PARTIALLY_SHARED_SIGNAL"
+            independent = 0
+        elif in_official_lo2:
+            verdict = "OFFICIAL_LO2_PROMOTION_ONLY"
+            leakage_status = "PARTIALLY_SHARED_SIGNAL"
