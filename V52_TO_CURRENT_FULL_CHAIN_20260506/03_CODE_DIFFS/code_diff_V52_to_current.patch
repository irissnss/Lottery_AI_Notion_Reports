+        conn.close()
+        return {"region": region, "error": "no_experimental_preview_rows"}
+    rows = conn.execute(
+        f"SELECT DISTINCT date FROM {PREVIEW_TABLE} WHERE region=? AND date >= date(?, ?) AND date <= ? ORDER BY date",
+        (region, latest, f"-{days - 1} days", latest),
+    ).fetchall()
+    conn.close()
+    return {
+        "region": region,
+        "latest": latest,
+        "days": days,
+        "results": [
+            materialize_for(r["date"], region, mode="POST_CLOSEOUT_DIAGNOSTIC_FULL_25")
+            for r in rows
