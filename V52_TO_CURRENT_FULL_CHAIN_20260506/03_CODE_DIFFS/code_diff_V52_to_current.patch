+def _order_shadow_models_for_region(models: list, region: str, date_str: str) -> list:
+    """Order shadow models by test-lane budget/tensor strength for timely output.
+
+    Fast no-token models already run in the 04:00 batch before token/shadow AI.
+    This ordering affects only shadow_auto_eval sequencing: stronger bucket
+    models should run earlier so `/du-doan-test` has useful signals before weak
+    long-tail models finish.
+    """
+    try:
+        if not models:
+            return []
+        from database import get_connection
+        conn = get_connection()
+        conn.row_factory = sqlite3.Row
+        cur = conn.cursor()
+        # Prefer C-16 budget rows when available for this date/region.
+        rows = cur.execute(
+            """
+            SELECT model_name, selector_role, final_budget_score, model_rank
+            FROM du_doan_test_selected_voters
+            WHERE run_date=? AND region=?
+            ORDER BY
+              CASE selector_role WHEN 'CONTROL' THEN 0 WHEN 'SELECTED_VOTER' THEN 1 WHEN 'WATCH_ONLY' THEN 2 ELSE 3 END,
+              final_budget_score DESC,
+              model_rank ASC
+            """,
+            (date_str, region),
+        ).fetchall()
+        rank = {}
+        base = len(models) + 100
+        for idx, row in enumerate(rows):
+            rank[row["model_name"]] = (idx, -float(row["final_budget_score"] or 0))
+        if rank:
+            ordered = sorted(models, key=lambda m: rank.get(m, (base, 0)))
+            conn.close()
+            return ordered
+
+        # Fallback before C-16 exists for the day: use latest tensor for region.
+        anchor_row = cur.execute(
+            "SELECT MAX(anchor_date) AS anchor FROM model_strength_by_region_weekday_station_daily WHERE anchor_date <= ?",
+            (date_str,),
+        ).fetchone()
+        anchor = anchor_row["anchor"] if anchor_row else None
+        strength = {}
+        if anchor:
+            qmarks = ",".join("?" for _ in models)
+            rows = cur.execute(
+                f"""
+                SELECT model_name, MAX(helpful_signal_strength) AS helpful, MAX(bt_rate) AS bt
+                FROM model_strength_by_region_weekday_station_daily
+                WHERE anchor_date=? AND region=? AND window_days=30 AND model_name IN ({qmarks})
+                GROUP BY model_name
+                """,
+                (anchor, region, *models),
+            ).fetchall()
+            for row in rows:
+                strength[row["model_name"]] = 0.65 * float(row["helpful"] or 0) + 0.35 * float(row["bt"] or 0)
+        conn.close()
+        return sorted(models, key=lambda m: strength.get(m, 0.0), reverse=True)
+    except Exception as exc:
+        _add_log(
+            f"⚠️ [SHADOW_ORDER_ERR] {region} {date_str}: {exc}; using registry order",
+            log_level='WARNING', job_name='shadow_eval', region=region, date_str=date_str
+        )
+        return list(models or [])
+
+
+def _run_du_doan_test_pre_result_trigger(trigger_source: str = "interval"):
+    """Auto-run /du-doan-test pre-result output when each region is ready.
+
+    Dynamic readiness, no hardcoded weekday/station:
+    - official final bundle exists for (today, region)
+    - production predictions exist for (today, region)
+    - target-region actual results are NOT present yet (pre-result only)
+    - no du_doan_test_bundles exist yet for (today, region)
+
+    Then C-16 budget is materialized and V52.5.6 runner creates test output.
+    Writes only test/diagnostic tables.
+    """
+    try:
+        from zoneinfo import ZoneInfo
+        VN_TZ = ZoneInfo("Asia/Ho_Chi_Minh")
+    except Exception:
+        from datetime import timezone, timedelta as td
+        VN_TZ = timezone(td(hours=7))
+    from datetime import datetime as _dt
+    today = _dt.now(VN_TZ).strftime("%Y-%m-%d")
+    try:
+        from database import get_connection
+        from _materialize_du_doan_test_model_budget import materialize_for as _mat_budget
+        from _du_doan_test_daily_runner import run as _run_test
+        conn = get_connection()
+        conn.row_factory = sqlite3.Row
+        cur = conn.cursor()
+        for region in ("MN", "MT", "MB"):
+            try:
+                fb = cur.execute(
+                    "SELECT COUNT(*) AS n FROM final_bundles WHERE date=? AND region=?",
+                    (today, region),
+                ).fetchone()["n"]
+                preds = cur.execute(
+                    "SELECT COUNT(*) AS n FROM predictions WHERE date=? AND target_region=?",
+                    (today, region),
+                ).fetchone()["n"]
+                actual = cur.execute(
+                    "SELECT COUNT(*) AS n FROM lottery_results WHERE date=? AND region=?",
+                    (today, region),
+                ).fetchone()["n"]
+                existing = cur.execute(
+                    "SELECT COUNT(*) AS n FROM du_doan_test_bundles WHERE run_date=? AND region=?",
+                    (today, region),
+                ).fetchone()["n"]
+                if not fb or preds < 7:
+                    continue
+                if actual:
+                    _add_log(
+                        f"[DU-DOAN-TEST-AUTO] skip {region}: actual already present; no pre-result lock",
+                        log_level='INFO', job_name='du_doan_test_auto', region=region, date_str=today,
+                    )
+                    continue
+                if existing:
+                    continue
+                _add_log(
+                    f"[DU-DOAN-TEST-AUTO] start {region}: fb={fb} preds={preds} trigger={trigger_source}",
+                    log_level='INFO', job_name='du_doan_test_auto', region=region, date_str=today,
+                )
+                budget = _mat_budget(today, region)
+                result = _run_test(today, region=region, mode="REALTIME_AVAILABLE_ONLY", dry_run=False)
+                _add_log(
+                    f"[DU-DOAN-TEST-AUTO] done {region}: budget_selected={budget.get('selected_count')} "
+                    f"runs={result.get('created_runs')} bundles={result.get('created_bundles')}",
+                    log_level='INFO', job_name='du_doan_test_auto', region=region, date_str=today,
+                )
+            except Exception as per_region_err:
+                _add_log(
+                    f"⚠️ [DU-DOAN-TEST-AUTO_ERR] {region}: {per_region_err}",
+                    log_level='WARNING', job_name='du_doan_test_auto', region=region, date_str=today,
+                )
+        conn.close()
+    except Exception as err:
+        _add_log(f"⚠️ [DU-DOAN-TEST-AUTO_FATAL] {err}", log_level='WARNING', job_name='du_doan_test_auto', date_str=today)
+
