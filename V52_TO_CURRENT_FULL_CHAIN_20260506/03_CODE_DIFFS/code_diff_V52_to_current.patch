+def _build_trace_bucket_context(target_region: str, date_str: str) -> Dict[str, object]:
+    """Build stable bucket metadata for trace/history surfaces."""
+    try:
+        from database import get_connection
+        dt = datetime.strptime(date_str, "%Y-%m-%d")
+        weekday_idx = dt.weekday()
+        sqlite_weekday = (weekday_idx + 1) % 7
+        bucket_code = f"{target_region}_{['T2','T3','T4','T5','T6','T7','CN'][weekday_idx]}"
+        weekday_name = ['Thứ 2','Thứ 3','Thứ 4','Thứ 5','Thứ 6','Thứ 7','CN'][weekday_idx]
+
+        conn = get_connection()
+        cur = conn.cursor()
+        cur.execute(
+            """
+            SELECT DISTINCT station
+            FROM lottery_results
+            WHERE region = ? AND CAST(strftime('%w', date) AS INTEGER) = ?
+            ORDER BY station
+            """,
+            ((target_region or "").upper(), sqlite_weekday),
+        )
+        stations = []
+        seen = set()
+        for row in cur.fetchall():
+            station = row[0] if not isinstance(row, dict) else row.get("station")
+            station = _normalize_bucket_station_name(station)
+            if station and station not in seen:
+                seen.add(station)
+                stations.append(station)
+        conn.close()
+        return {
+            "bucket_code": bucket_code,
+            "weekday_name": weekday_name,
+            "station_set": stations,
